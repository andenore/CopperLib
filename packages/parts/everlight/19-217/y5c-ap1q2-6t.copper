// Everlight 19-217/Y5C-AP1Q2/6T: brilliant yellow (AlGaInP) 1.6 x 0.8 x 0.4 mm
// SMD LED, water clear. JLCPCB/LCSC C2986063 (extended part).
// Package drawing (page 6): terminal 1 = "+" (anode), terminal 2 = "-"
// (cathode, cathode mark). Pin numbers are the manufacturer terminal numbers;
// they are the reverse of KiCad LED_0603_1608Metric (K=1, A=2), so this part
// uses the package-local footprint with cathode pad 2 on the marked side.
// Ratings (pages 2-3, Ta=25 degC): VF 1.70 min / 2.00 typ / 2.40 max V at
// IF=20 mA; IF 25 mA max; IFP 60 mA (1/10 duty, 1 kHz); Pd 60 mW; ESD HBM
// 2000 V; Iv 45-112 mcd and lambda_d 585.5-594.5 nm at 20 mA; -40 to +85
// degC. Reverse voltage is a leakage-test condition only.
part EVERLIGHT_19_217_Y5C_AP1Q2_6T {
    category = "optoelectronics.led";
    manufacturer = "Everlight Electronics";
    footprint = "footprints/EVERLIGHT_19-217.kicad_mod";
    source_document = "Everlight datasheet 19-217/Y5C-AP1Q2/6T, issue no. DSE-0025584";
    source_revision = "Rev.3, release date 21.Jul.2023";
    source_url = "https://www.everlighteurope.com/custom/files/datasheets/DSE-0025584.pdf";
    source_location = "Page 6 package dimension and polarity; pages 2-3 ratings and electro-optical characteristics";
    source_checksum = "sha256:891ebd4dc8843d71d49bb6a74bbd23932886617ea72d2a3509b0c8a71d39ec1f";
    pin A { number = "1"; domains = "analog"; directions = "passive"; }
    pin K { number = "2"; domains = "analog"; directions = "passive"; }
}
