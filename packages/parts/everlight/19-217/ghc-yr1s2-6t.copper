// Everlight 19-217/GHC-YR1S2/6T: brilliant green (InGaN) 1.6 x 0.8 x 0.4 mm
// SMD LED, water clear. JLCPCB/LCSC C2986059 (extended part).
// Package drawing (page 6): terminal 1 = "+" (anode), terminal 2 = "-"
// (cathode, cathode mark). Pin numbers are the manufacturer terminal numbers;
// they are the reverse of KiCad LED_0603_1608Metric (K=1, A=2), so this part
// uses the package-local footprint with cathode pad 2 on the marked side.
// Ratings (pages 2-3, Ta=25 degC): VF 2.7 min / 3.3 typ / 3.7 max V at
// IF=20 mA; IF 25 mA max; IFP 50 mA (1/10 duty, 1 kHz); Pd 95 mW; ESD HBM
// 150 V; Iv 112-285 mcd and lambda_d 520-535 nm at 20 mA; -40 to +85 degC.
// Reverse voltage is a leakage-test condition only (not for reverse operation).
part EVERLIGHT_19_217_GHC_YR1S2_6T {
    category = "optoelectronics.led";
    manufacturer = "Everlight Electronics";
    footprint = "footprints/EVERLIGHT_19-217.kicad_mod";
    source_document = "Everlight datasheet 19-217/GHC-YR1S2/6T, issue no. DSE-0025583";
    source_revision = "Rev.3, release date May.31.2022";
    source_url = "https://www.everlighteurope.com/custom/files/datasheets/DSE-0025583.pdf";
    source_location = "Page 6 package dimension and polarity; pages 2-3 ratings and electro-optical characteristics";
    source_checksum = "sha256:4d0eb56e7dc66ab0a81ca648a8f56c5c1442ab5c74ac46bc298478b02533aa17";
    pin A { number = "1"; domains = "analog"; directions = "passive"; }
    pin K { number = "2"; domains = "analog"; directions = "passive"; }
}
