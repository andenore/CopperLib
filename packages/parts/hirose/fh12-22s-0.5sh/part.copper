// Hirose FH12-22S-0.5SH(55): 22-position, 0.5 mm pitch FPC connector, bottom
// contact, flip lock, 2.0 mm high. LCSC C597981 (extended).
// Hirose FH12 catalogue (2020-05-01) recommended land, 22P: signal pads
// 0.3 x 1.3 at 0.5 pitch, mounting lands 1.8 x 2.2 at +/-7.15; KiCad's
// standard Hirose_FH12-22S-0.5SH footprint matches it exactly, with pad 1 on
// the left and the cable entering from the front (+Y). Positions carry no
// signal meaning here; an interface module assigns them.
part HIROSE_FH12_22S_0_5SH {
    category = "connector.fpc";
    manufacturer = "Hirose";
    footprint = "Connector_FFC-FPC:Hirose_FH12-22S-0.5SH_1x22-1MP_P0.50mm_Horizontal";
    source_document = "FH12 series catalogue";
    source_revision = "2020-05-01";
    source_location = "p. 10 recommended PCB mounting pattern (22P row)";
    source_url = "https://datasheet.lcsc.com/datasheet/pdf/b87be22e0cecc59ab77d96f3dce601d5.pdf?productCode=C597981";
    source_checksum = "sha256:ed14d17173fac1340292e511e9ad725c3e0240441751d8031f894178b1c65f99";
    pin P1 { number = "1"; domains = "analog,digital,power,ground"; directions = "passive"; }
