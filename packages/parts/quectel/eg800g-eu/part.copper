// Non-production electrical subset for the board architecture. All 109 physical
// lands are represented, but UNMODELED_* entries intentionally have no claimed
// electrical profile. Ground lands follow Quectel's QuecOpen Reference Design
// V1.1, page 3 (PDF page 8); JLCPCB/EasyEDA supplies geometry only. Its symbol
// disagrees with the Quectel reference on several multifunction lands.
part EG800G_EU {
    category = "module.cellular.lte_cat1bis";
    manufacturer = "Quectel";
    footprint = "EG800G:Quectel_EG800G";
    source_document = "EG800G Series Hardware Design";
    source_revision = "V1.2";
    source_url = "https://developer.quectel.com/modules-cat/eg800g-series";
    pin PWRKEY { number = "7"; domains = "digital"; directions = "input"; voltage_max = 1.9V; }
    pin GND { number = "10"; domains = "ground"; directions = "input"; }
    pin USIM_DATA { number = "11"; domains = "digital"; directions = "bidirectional"; }
    pin USIM_RST { number = "12"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; }
    pin USIM_CLK { number = "13"; domains = "digital,clock"; directions = "output"; drive_modes = "push_pull"; }
    pin USIM_VDD { number = "14"; domains = "power"; directions = "output"; }
    pin RESET_N { number = "15"; domains = "digital"; directions = "input"; voltage_max = 1.9V; connection = optional; }
    pin NET_STATUS { number = "16"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; connection = optional; }
    pin MAIN_RXD { number = "17"; domains = "digital"; directions = "input"; voltage_max = 1.9V; }
    pin MAIN_TXD { number = "18"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; voltage_max = 1.9V; }
    pin VDD_EXT { number = "24"; domains = "power"; directions = "output"; voltage_min = 1.7V; voltage_max = 1.9V; }
    pin STATUS { number = "25"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; voltage_max = 1.9V; }
    pin ANT_MAIN { number = "35"; domains = "rf"; directions = "bidirectional"; traits = "cellular_rf"; }
    pin VBAT_1 { number = "42"; domains = "power"; directions = "input"; voltage_min = 3.3V; voltage_max = 4.3V; }
    pin VBAT_2 { number = "43"; domains = "power"; directions = "input"; voltage_min = 3.3V; voltage_max = 4.3V; }
    pin USB_DP { number = "59"; domains = "digital"; directions = "bidirectional"; traits = "usb_dp"; }
    pin USB_DM { number = "60"; domains = "digital"; directions = "bidirectional"; traits = "usb_dm"; }
    pin USB_VBUS { number = "61"; domains = "power"; directions = "input"; voltage_min = 4.4V; voltage_max = 5.25V; }
    // Unused functional lands remain optional until the full EG800G-EU device
    // model is reconciled. Unsupported GNSS/reserved lands must stay open.
    pin GND_1 { number = "1"; domains = "ground"; directions = "input"; }
    pin UNMODELED_2 { number = "2"; connection = do_not_connect; }
    pin UNMODELED_3 { number = "3"; connection = do_not_connect; }
    pin UNMODELED_4 { number = "4"; connection = do_not_connect; }
    pin UNMODELED_5 { number = "5"; connection = optional; }
    pin UNMODELED_6 { number = "6"; connection = optional; }
    pin UNMODELED_8 { number = "8"; connection = optional; }
    pin UNMODELED_9 { number = "9"; connection = optional; }
    pin UNMODELED_19 { number = "19"; connection = optional; }
    pin UNMODELED_20 { number = "20"; connection = optional; }
    pin UNMODELED_21 { number = "21"; connection = optional; }
    pin UNMODELED_22 { number = "22"; connection = optional; }
    pin UNMODELED_23 { number = "23"; connection = optional; }
    pin UNMODELED_26 { number = "26"; connection = optional; }
    pin GND_27 { number = "27"; domains = "ground"; directions = "input"; }
    pin UNMODELED_28 { number = "28"; connection = optional; }
    pin UNMODELED_29 { number = "29"; connection = optional; }
    pin UNMODELED_30 { number = "30"; connection = optional; }
    pin UNMODELED_31 { number = "31"; connection = optional; }
    pin UNMODELED_32 { number = "32"; connection = optional; }
    pin UNMODELED_33 { number = "33"; connection = optional; }
