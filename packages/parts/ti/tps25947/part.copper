    manufacturer = "Texas Instruments";
    footprint = "footprints/TI_RPW0010A_TPS25947.kicad_mod";
    height = 1mm;
    source_url = "https://www.ti.com/lit/ds/symlink/tps25947.pdf";
    source_revision = "SLVSFC9C May 2026";
