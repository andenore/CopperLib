    pin OUT { number = "6"; domains = "power"; directions = "output"; voltage_max = 23V; }
    pin DVDT { number = "7"; domains = "analog"; directions = "passive"; connection = optional; }
    pin GND { number = "8"; domains = "ground"; directions = "input"; }
    pin ILM { number = "9"; domains = "analog"; directions = "passive"; }
    pin ITIMER { number = "10"; domains = "analog"; directions = "passive"; connection = optional; }
