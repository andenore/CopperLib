    pin EN_UVLO { number = "1"; domains = "analog,digital"; directions = "input"; voltage_max = 5V; }
    pin OVLO { number = "2"; domains = "analog"; directions = "input"; }
    pin AUXOFF { number = "3"; domains = "digital"; directions = "output"; drive_modes = "open_drain"; connection = optional; }
    pin FLT_N { number = "4"; domains = "digital"; directions = "output"; drive_modes = "open_drain"; }
