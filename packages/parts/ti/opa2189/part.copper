// Simulation models (CopperScript sim blocks), from the OPAx189 data sheet
// SBOS830I (September 2017, revised October 2021), https://www.ti.com/lit/ds/symlink/opa2189.pdf,
// sha256 0d8a997989aeb64693a4b2bf9c74f2fee1f006accc88b88bae2e9a7025cd6932, read 2026-11-20.
// Typical values at TA = 25 C, VS = +/-18 V, RL = 10 kohm to VS/2, from 7.7
// Electrical Characteristics (pp. 9-11), OPA2189 rows:
//   GBW 14 MHz at AV = 1000 (unity-gain bandwidth 8 MHz; p. 10); open-loop gain
//   170 dB (p. 10); CMRR 168 dB (p. 10); PSRR 0.005 uV/V = 166 dB (p. 9); input
//   impedance 0.1 Gohm || 5.5 pF differential, 60 Tohm || 1.7 pF common mode
//   (p. 10); input bias current +/-70 pA, offset current +/-140 pA, offset
//   voltage +/-1.5 uV (OPA2189ID; p. 9); voltage noise 5.2 nV/rtHz at 10 Hz to
//   10 kHz, current noise 165 fA/rtHz at 1 kHz (p. 9); slew rate 20 V/us
//   (p. 10); output swing from either rail 20 mV typical, 110 mV maximum with
//   RL = 10 kohm (p. 11); short-circuit current +/-65 mA (p. 11); quiescent
//   current 1.3 mA per amplifier (p. 11). Supply 4.5 V to 36 V (7.3, p. 7).
// Read from figures (approximate): Fig 7-25 (p. 17) open-loop output impedance
//   flat at about 1.8 ohm from 200 Hz to 1 kHz, rising above (380 ohm at 1 MHz,
//   EC p. 11); Fig 7-14 (p. 15) CMRR 86 dB at 1 kHz, -PSRR 122 dB at 1 Hz and
//   falling 20 dB per decade.
// Derived: psrr_corner 0.0063 Hz puts the table's 166 dB at Fig 7-14's 122 dB at
//   1 Hz (the -PSRR, the worse rail; +PSRR is 3 dB down at about 16 Hz).
// Not modelled: the CMRR's fall with frequency. A single corner that meets the
//   figure at 1 kHz (0.08 Hz from 168 dB, or 6.5 Hz from the figure's 130 dB
//   plateau) leaves about 3 dB at the 14 MHz gain-bandwidth, where the macro
//   model's common-mode error then feeds forward (copper sim --check-model: phase
//   margin 110 degrees, follower bandwidth 33 MHz, slew rate 67 V/us), so the
//   block keeps the flat 168 dB.
// Zero-drift amplifier: no 1/f noise region (Fig 7-18), so no voltage_noise_corner.
// Vendor model: TI's OPAx189 PSpice model, archive SBOMAE9 (Rev. E, model
// Final 1.2), member OPAx189.LIB, .SUBCKT OPAx189 IN+ IN- VCC VEE OUT. Fetch it
// with copper models fetch BOARD; it is never committed.
part OPA2189IDR {
 footprint = "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm";
 source_url = "https://www.ti.com/lit/ds/symlink/opa2189.pdf"; source_revision = "SBOS830I"; source_location = "OPA2189 D package pin configuration";
 pin OUTA { number = "1"; domains = "analog"; directions = "output"; }
 pin INA_N { number = "2"; domains = "analog"; directions = "input"; }
 pin INA_P { number = "3"; domains = "analog"; directions = "input"; }
 pin VM { number = "4"; domains = "power"; directions = "input"; }
 pin INB_P { number = "5"; domains = "analog"; directions = "input"; }
 pin INB_N { number = "6"; domains = "analog"; directions = "input"; }
 pin OUTB { number = "7"; domains = "analog"; directions = "output"; }
 pin VP { number = "8"; domains = "power"; directions = "input"; }

 sim opamp A {
  inp = INA_P; inn = INA_N; out = OUTA; vp = VP; vn = VM;
  gbw = 14MHz;                                // 7.7 EC p. 10, AV = 1000
  open_loop_gain = 170dB;                     // 7.7 EC p. 10
  cmrr = 168dB;                               // 7.7 EC p. 10
  psrr = 166dB;                               // 7.7 EC p. 9
  psrr_corner = 0.0063Hz;                     // derived, see above
  input_capacitance_common = 1.7pF;           // 7.7 EC p. 10
  input_capacitance_differential = 5.5pF;     // 7.7 EC p. 10
  input_resistance_common = 60000000Mohm;     // 60 Tohm, 7.7 EC p. 10
  input_resistance_differential = 100Mohm;    // 0.1 Gohm, 7.7 EC p. 10
  input_bias_current = 70pA;                  // 7.7 EC p. 9
  input_offset_current = 140pA;               // 7.7 EC p. 9
  input_offset_voltage = 1.5uV;               // 7.7 EC p. 9, OPA2189ID
  voltage_noise = 5.2nV/rtHz;                 // 7.7 EC p. 9
  current_noise = 165fA/rtHz;                 // 7.7 EC p. 9
  slew_rate = 20V/us;                         // 7.7 EC p. 10
  output_resistance = 1.8ohm;                 // read from Fig 7-25
  output_swing_from_rail = 110mV;             // 7.7 EC p. 11, maximum, RL = 10 kohm
  output_current_limit = 65mA;                // 7.7 EC p. 11, short circuit
  quiescent_current = 1.3mA;                  // 7.7 EC p. 11, per amplifier
 }
 sim opamp B {
  inp = INB_P; inn = INB_N; out = OUTB; vp = VP; vn = VM;
  gbw = 14MHz; open_loop_gain = 170dB; cmrr = 168dB; psrr = 166dB; psrr_corner = 0.0063Hz;
  input_capacitance_common = 1.7pF; input_capacitance_differential = 5.5pF;
  input_resistance_common = 60000000Mohm; input_resistance_differential = 100Mohm;
  input_bias_current = 70pA; input_offset_current = 140pA; input_offset_voltage = 1.5uV;
  voltage_noise = 5.2nV/rtHz; current_noise = 165fA/rtHz; slew_rate = 20V/us;
  output_resistance = 1.8ohm; output_swing_from_rail = 110mV; output_current_limit = 65mA;
  quiescent_current = 1.3mA;
 }
 sim spice A {
  source = "https://www.ti.com/lit/zip/SBOMAE9";
  sha256 = "5827cfe64cbec39de7f6b28fcc7d59a0f7c2b5b1116c21d28fcffe6513bd8b03";
  member = "OPAx189.LIB";
  subckt = "OPAx189";
  dialect = pspice;
  terminals = INA_P, INA_N, VP, VM, OUTA;
 }
 sim spice B {
  source = "https://www.ti.com/lit/zip/SBOMAE9";
  sha256 = "5827cfe64cbec39de7f6b28fcc7d59a0f7c2b5b1116c21d28fcffe6513bd8b03";
  member = "OPAx189.LIB";
  subckt = "OPAx189";
  dialect = pspice;
  terminals = INB_P, INB_N, VP, VM, OUTB;
 }
}
