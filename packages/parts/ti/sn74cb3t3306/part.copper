    source_checksum = "sha256:031e6d810f30687ba0479e414ef536388b8d7fb8ad3ae92c6efb3b5526bfd3f3";
    pin OE1 { number = "1"; domains = "digital"; directions = "input"; }
    pin A1 { number = "2"; domains = "digital,analog"; directions = "passive"; }
    pin B1 { number = "3"; domains = "digital,analog"; directions = "passive"; }
    pin GND { number = "4"; domains = "ground"; directions = "input"; connection = "required"; }
    pin A2 { number = "5"; domains = "digital,analog"; directions = "passive"; }
    pin B2 { number = "6"; domains = "digital,analog"; directions = "passive"; }
    pin OE2 { number = "7"; domains = "digital"; directions = "input"; }
    pin VCC { number = "8"; domains = "power"; directions = "input"; connection = "required"; voltage_min = 2.3V; voltage_max = 3.6V; }
