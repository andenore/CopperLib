// TI DCU package; bidirectional pass switches, NOT logic buffers.
part SN74CB3T3306DCUR {
    manufacturer = "Texas Instruments";
    category = "interface.bus_switch";
    footprint = "Package_SO:VSSOP-8_2.3x2mm_P0.5mm";
    source_document = "SN74CB3T3306 SCDS119C, December 2015";
    source_location = "p1 Ioff partial power down, 2.3-3.6V VCC, output tracks VCC; p3 DCU pin functions";
