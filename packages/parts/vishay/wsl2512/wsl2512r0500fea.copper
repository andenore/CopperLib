// Vishay 30100, 23-Nov-2023: two-terminal 50 mOhm WSL2512.
part WSL2512R0500FEA {
    category = "passive.resistor";
    manufacturer = "Vishay";
    footprint = "footprints/WSL2512_7m_to_500m.kicad_mod";
    // KiCad's generic 2512 chip resistor body: same 6.3 x 3.2 mm outline.
    model = "github.com/KiCad/kicad-packages3D/Resistor_SMD.3dshapes/R_2512_6332Metric.step";
    pin P1 { number = "1"; domains = "analog,power"; directions = "passive"; }
    pin P2 { number = "2"; domains = "analog,power"; directions = "passive"; }
}
