// GUOCONN 0.5K-GX-22PWB-R: 22-position, 0.5 mm pitch FPC/FFC connector, dual
// contact (top and bottom), front insertion, rear flip lock, 2.0 mm high.
// LCSC C53223210 (extended).
// Drawing 0.5K-GX-NPWB-R rev A ("NEW DRAWING"): signal pads 0.30 x 1.20 at
// 0.5 pitch, mounting pads 1.80 x 2.00 at +/-6.90, 3.15 mm forward of the
// signal-pad centres; circuit 1 on the left looking down with the cable
// entering from the front (+Y in the footprint). The EasyEDA footprint
// FPC-SMD_22P-P0.50_0.5K-GX-22PWB-R matches these numbers.
// Dual contact accepts same-side and opposite-side cables. Positions carry no
// signal meaning here; an interface module assigns them.
part GUOCONN_0_5K_GX_22PWB_R {
    category = "connector.fpc";
    manufacturer = "GUOCONN";
    footprint = "footprints/Connector_GUOCONN.pretty/GUOCONN_0.5K-GX-22PWB-R.kicad_mod";
    source_document = "0.5K-GX-NPWB-R FPC connector drawing";
    source_revision = "rev A";
    source_location = "land pattern, dimension table (22P) and circuit-1 marking";
    source_url = "https://datasheet.lcsc.com/datasheet/pdf/8e44912e5203b7c80c9c7b2af63ab5bf.pdf?productCode=C53223210";
    source_checksum = "sha256:52cba0f116520b4ed99bf348f9b1591367d9c1dc162ac81f9ee8c576fd292631";
