// Holder only: the board declares an installed, non-rechargeable cell as an
// external supply. Pad numbering follows KiCad's Keystone 3034 footprint.
part KEYSTONE_3034 {
    category = "connector.battery.coin_cell";
    manufacturer = "Keystone Electronics";
    footprint = "Battery:BatteryHolder_Keystone_3034_1x20mm";
    // Both solder tabs are the same conductive positive retainer. Keep the
    // centre negative PCB contact separate; its external connection is required.
    internal_pad_groups = "1";
    source_document = "Keystone M65 catalogue: 3034 SMT retainer for 20 mm cells; KiCad footprint pad numbering";
    source_url = "https://www.keyelco.com/userAssets/file/M65p9.pdf";
    source_location = "M65 catalogue page 9, figure 1 and 3034 row";
    source_checksum = "sha256:58aa74ce778e2b3315b3388ff3feda6831b9b99ba4c1696358a7644b6d87c39a";
    pin POS { number = "1"; domains = "power"; directions = "passive"; }
    pin NEG { number = "2"; domains = "ground"; directions = "passive"; }
}
