// 32MHz, not the 25MHz X322525MOB4SI from CopperLib. Catalog C9009.
// Exact option decoding and load tuning remain a pre-production review item.
part YXC_X322532MOB4SI {
    category = "passive.crystal";
    manufacturer = "YXC (Yangxing Technology)";
    footprint = "Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm";
