// I-PEX CABLINE-CA receptacle 20525-040E-02: 40 positions, 0.4 mm pitch, horizontal-mating
// micro-coax / FPC board connector (mate for CABLINE-CA harnesses 82652/82653 and CABLINE-CAF
// shell assemblies 20858-040T-01).
// Ratings, I-PEX drawing 20525 rev 34 sheet 3/7 (CABLINE-CA plug cable assembly table):
// operating temperature -40 to +85 degC (233 to 358 K); 0.3 A AC/DC per contact pin with
// AWG #40 cable, up to 40 contacts; 100 V AC per contact pin (harness rating may be lower;
// harness drawings 82652/82653 state 30 V and 80 degC max). Sheet 4/7 (CABLINE-CAF): 0.3 A per
// contact for all pin counts, -40 to +85 degC.
// Position 1 is the datum-mark end (sheet 1/7 top view; see evidence/footprint-audit.json).
// SH covers every non-signal land (2 end tails, 6 ground-contact lands, 4 shell tabs); no
// internal_pad_groups: each SH land must be routed to the ground net explicitly.
part IPEX_20525_040E_02 {
    category = "connector.micro_coax";
    manufacturer = "I-PEX";
    footprint = "footprints/Connector_I-PEX.pretty/I-PEX_20525-040E-02.kicad_mod";
    source_document = "CABLINE-CA receptacle assembly, drawing 20525 (customer copy)";
    source_revision = "20525 rev 34";
    source_location = "Sheet 1/7 outline and datum mark; sheet 2/7 bottom view, 40P (six non-signal contacts, 2.40 pitch, 12.00 span); sheets 3-4/7 ratings; sheet 5/7 recommended footprint pattern and metal mask, 40P row; sheet 6/7 connector on footprint";
    source_url = "https://www.i-pex.com/sites/default/files/downloads/pdf/2D_CABLINE-CA_RECEPTACLE_20525C34.pdf";
    source_checksum = "sha256:54a4dff3d49a9247c161bc00c10aebbd2b23e06068ab6aa8f5087730704d7eb3";
