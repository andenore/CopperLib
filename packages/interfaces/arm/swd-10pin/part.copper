// Samtec FTSH-105-01-L-DV-007-K, assembled 1.27 mm SMT Cortex Debug header.
// Position 7 is the absent key.
part SWD_HEADER {
    category = "connector.debug.swd";
    manufacturer = "Samtec";
    footprint = "Connector_Debug:FTSH-105-01-L-DV-007-K";
    // Approximate: KiCad's 2x5 1.27 mm SMD header on the same grid and origin;
    // its pads sit 0.24 mm further out and it still shows position 7.
    model = "github.com/KiCad/kicad-packages3D/Connector_PinHeader_1.27mm.3dshapes/PinHeader_2x05_P1.27mm_Vertical_SMD.step";
    source_document = "FTSH vertical surface-mount recommended PCB layout, rev H; Arm Cortex-M Debug Connectors";
    source_url = "https://www.samtec.com/products/ftsh-105-01-l-dv-007-k";
    pin VREF { number = "1"; domains = "power"; directions = "input"; }
    pin SWDIO { number = "2"; domains = "digital"; directions = "passive"; }
    pin GND { number = "3"; domains = "ground"; directions = "input"; }
    pin SWDCLK { number = "4"; domains = "digital,clock"; directions = "passive"; }
    pin GND_5 { number = "5"; domains = "ground"; directions = "input"; }
    pin SWO { number = "6"; domains = "digital"; directions = "passive"; connection = optional; }
    pin NC_8 { number = "8"; domains = "digital"; directions = "passive"; connection = do_not_connect; }
    pin GND_DETECT { number = "9"; domains = "ground"; directions = "input"; }
    pin RESET { number = "10"; domains = "digital"; directions = "passive"; }
}
