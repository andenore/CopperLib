// GCT SIM8060-6-0-14-00-A hinged nano-SIM, no card-detect switch.
// Contacts C1/C2/C3/C5/C6/C7 and shell pads follow the GCT SIM8060 drawing:
// https://gct.co/files/drawings/sim8060.pdf (drawing A2, sheet 1/4).
part NANO_SIM_SOCKET {
    category = "connector.card.sim";
    manufacturer = "GCT";
    footprint = "Connector_Card:nanoSIM_GCT_SIM8060-6-0-14-00";
    pin VCC { number = "1"; domains = "power"; directions = "input"; }
    pin RST { number = "2"; domains = "digital"; directions = "input"; }
    pin CLK { number = "3"; domains = "digital,clock"; directions = "input"; }
    pin GND { number = "5"; domains = "ground"; directions = "input"; }
    pin VPP { number = "6"; domains = "power"; directions = "passive"; connection = optional; }
    pin IO { number = "7"; domains = "digital"; directions = "bidirectional"; }
    pin SHIELD { number = "SH"; domains = "ground"; directions = "passive"; }
}
