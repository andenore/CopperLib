// Prototype antenna selection; RF matching and footprint require vendor validation.
part RF_ANTENNA {
    category = "rf.antenna";
    footprint = "RF_Antenna:Johanson_2450AT18x100";
    pin FEED { number = "1"; domains = "rf"; directions = "passive"; traits = "antenna"; }
    pin GND { number = "2"; domains = "ground"; directions = "input"; }
}
