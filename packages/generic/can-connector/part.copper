// Prototype connector selection; verify the exact orderable part and footprint.
part CAN_CONNECTOR {
    category = "connector.bus.can";
    footprint = "footprints/TerminalBlock_Phoenix.pretty/TerminalBlock_Phoenix_MKDS-1,5-3_1x03_P5.00mm_Horizontal.kicad_mod";
    model = "github.com/KiCad/kicad-packages3D/TerminalBlock_Phoenix.3dshapes/TerminalBlock_Phoenix_MKDS-1,5-3_1x03_P5.00mm_Horizontal.step";
    pin CANH { number = "1"; domains = "analog"; directions = "passive"; traits = "can_bus"; }
    pin CANL { number = "2"; domains = "analog"; directions = "passive"; traits = "can_bus"; }
    pin GND { number = "3"; domains = "ground"; directions = "input"; }
}
