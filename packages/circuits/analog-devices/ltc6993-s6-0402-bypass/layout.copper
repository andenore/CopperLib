macro LTC6993_S6_0402_BYPASS {
 source = { datasheet_url="https://www.analog.com/media/en/technical-documentation/data-sheets/ltc6993-6993-1-6993-2-6993-3-6993-4.pdf"; datasheet_locator="LTC6993 Rev F bypass recommendation and p26 S6 lands"; adaptation="Authored local bypass branch; host routes IC ground, SET, DIV and signals."; };
 unresolved=["Host IC ground return, SET/DIV local wiring and filled plane continuity", "host timing, supply integrity and EMI qualification"];
 anchor=U; required_layers=["F.Cu","In1.Cu","In2.Cu","B.Cu"]; allowed_rotations=[0 deg,90 deg,180 deg,270 deg]; internal_clearance=0.15mm;
 net SUPPLY; net GROUND;
 member U { footprint="github.com/andenore/CopperLib/packages/parts/analog-devices/ltc6993-1/footprints/ADI_S6_TSOT23_6.kicad_mod"; at=(0mm,0mm); rotation=0deg; }
 member C { footprint="github.com/KiCad/kicad-footprints/Capacitor_SMD.pretty/C_0402_1005Metric.kicad_mod"; at=(3.65mm,0mm); rotation=0deg; }
 pad U."5"=SUPPLY; pad C."1"=SUPPLY; pad C."2"=GROUND;
 track bypass_supply { net=SUPPLY; layer="F.Cu"; width=0.25mm; points=[U."5",C."1"]; }
 track bypass_ground { net=GROUND; layer="F.Cu"; width=0.25mm; points=[C."2",(4.95mm,0mm)]; }
 width_contract local_supply_branch { track=bypass_supply; minimum_width=0.25mm; purpose="control_supply"; evidence="Only chip-local bypass lead; host supply distribution attaches at capacitor port. LTC6993 Rev F supply bypass recommendation. This scoped branch is not a rail distribution-width change."; }
 width_contract local_bypass_return { track=bypass_ground; minimum_width=0.25mm; purpose="control_supply"; evidence="Only local bypass-capacitor current reaches its adjacent plane via; no host load-return distribution through this branch."; }
 via bypass_return { net=GROUND; at=(4.95mm,0mm); size=0.6mm; drill=0.3mm; from_layer="F.Cu"; to_layer="B.Cu"; technology=none; }
 port SUPPLY { net=SUPPLY; layer="F.Cu"; point=C."1"; pads=[U."5",C."1"]; }
 plane_return bypass_plane { net=GROUND; layers=["In1.Cu","In2.Cu"]; pads=[C."2"]; contact capacitor { pad=C."2"; at=(4.95mm,0mm); } }
}

