// Temporary fixture; default member-edge clearance is 0.25mm.
// Exact managed courtyards have 0.5mm added separation at this pose.
macro TPS22918_DBV_0603_BYPASS {
 source={url="https://www.ti.com/lit/ds/symlink/tps22918.pdf";revision="SLVSD76C";locator="DBV pin1 VIN and input bypass";geometry_status="Authored from exact managed SOT-23-6 and 0603 footprints; not qualification.";};
 unresolved=["Host IC ground and complete bypass loop", "Load current, timing and assembly qualification"];
 anchor=U;required_layers=["F.Cu","In1.Cu","In2.Cu","B.Cu"];allowed_rotations=[0deg,90deg,180deg,270deg];internal_clearance=0.15mm;
 net SUPPLY;net GROUND;
 member U {footprint="github.com/KiCad/kicad-footprints/Package_TO_SOT_SMD.pretty/SOT-23-6.kicad_mod";at=(0mm,0mm);rotation=0deg;}
 member C {footprint="github.com/KiCad/kicad-footprints/Capacitor_SMD.pretty/C_0603_1608Metric.kicad_mod";at=(-1.1375mm,-3.68mm);rotation=90deg;}
 pad U."1"=SUPPLY;pad C."1"=SUPPLY;pad C."2"=GROUND;
 track bypass_supply {net=SUPPLY;layer="F.Cu";width=0.25mm;points=[U."1",C."1"];}
 track bypass_ground {net=GROUND;layer="F.Cu";width=0.25mm;points=[C."2",(-1.1375mm,-5.23mm)];}
 width_contract local_supply_branch {track=bypass_supply;minimum_width=0.25mm;purpose="control_supply";evidence="Local input bypass branch; host distribution attaches at capacitor port. Host rail width remains unchanged.";}
 width_contract local_return_branch {track=bypass_ground;minimum_width=0.25mm;purpose="control_supply";evidence="Local bypass capacitor current into adjacent ground via; host IC and load ground are separate obligations.";}
 via bypass_return {net=GROUND;at=(-1.1375mm,-5.23mm);size=0.6mm;drill=0.3mm;from_layer="F.Cu";to_layer="B.Cu";technology=none;}
 port SUPPLY {net=SUPPLY;layer="F.Cu";point=C."1";pads=[U."1",C."1"];}
 plane_return bypass_plane {net=GROUND;layers=["In1.Cu","In2.Cu"];pads=[C."2"];contact capacitor {pad=C."2";at=(-1.1375mm,-5.23mm);}}
}
