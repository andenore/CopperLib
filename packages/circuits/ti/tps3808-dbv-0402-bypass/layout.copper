// Temporary local bypass layout; host owns IC ground and functional networks.
macro TPS3808_DBV_0402_BYPASS {
 source={url="https://www.ti.com/lit/ds/symlink/tps3808.pdf"; revision="SBVS050N"; locator="DBV pin6 VDD and local bypass guidance"; geometry_status="Authored from current exact managed SOT23-6 footprint; not vendor CAD or qualification.";};
 unresolved=["Host IC ground connection and complete bypass loop", "SENSE/MR/CT/reset network and startup qualification", "Source binary capture/hash and assembly review"];
 anchor=U; required_layers=["F.Cu","In1.Cu","In2.Cu","B.Cu"]; allowed_rotations=[0deg,90deg,180deg,270deg]; internal_clearance=0.15mm;
 net SUPPLY; net GROUND;
 member U {footprint="github.com/KiCad/kicad-footprints/Package_TO_SOT_SMD.pretty/SOT-23-6.kicad_mod";at=(0mm,0mm);rotation=0deg;}
 member C {footprint="github.com/KiCad/kicad-footprints/Capacitor_SMD.pretty/C_0402_1005Metric.kicad_mod";at=(3.5mm,-0.95mm);rotation=0deg;}
 pad U."6"=SUPPLY;pad C."1"=SUPPLY;pad C."2"=GROUND;
 track bypass_supply {net=SUPPLY;layer="F.Cu";width=0.25mm;points=[U."6",C."1"];}
 track bypass_ground {net=GROUND;layer="F.Cu";width=0.25mm;points=[C."2",(4.8mm,-0.95mm)];}
 width_contract local_supply_branch {track=bypass_supply;minimum_width=0.25mm;purpose="control_supply";evidence="Chip-local bypass branch only; host distribution attaches at capacitor port. Not a reduction of host rail width.";}
 width_contract local_return_branch {track=bypass_ground;minimum_width=0.25mm;purpose="control_supply";evidence="Local bypass capacitor current only into adjacent ground via; host IC ground and load returns remain separate obligations.";}
 via bypass_return {net=GROUND;at=(4.8mm,-0.95mm);size=0.6mm;drill=0.3mm;from_layer="F.Cu";to_layer="B.Cu";technology=none;}
 port SUPPLY {net=SUPPLY;layer="F.Cu";point=C."1";pads=[U."6",C."1"];}
 plane_return bypass_plane {net=GROUND;layers=["In1.Cu","In2.Cu"];pads=[C."2"];contact capacitor {pad=C."2";at=(4.8mm,-0.95mm);}}
}
