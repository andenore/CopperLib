// Authored control and local output bypass; host owns the remaining power stage.
macro TPS63020_FOUR_LAYER_LOCAL_OUTPUT_WITH_INDUCTOR {
    source = {
        datasheet_url = "https://www.ti.com/lit/ds/symlink/tps63020.pdf";
        datasheet_locator = "SLVS916I Rev I, section 10.1, Figure 31, p23; DSJ land drawings pp31-33";
        datasheet_sha256 = "d117773bb7370fd79377bc70ce987eec3469ea5979547a09df52fca5f95b2e69";
        geometry_status = "Authored four-layer adaptation, not extracted TI CAD. Owns surface feedback, quiet GND-to-PGND tie, VINA bypass, local VOUT4/VOUT5 join and one 0805 output bypass with separate sense branch. Host owns input power, remaining output bank, switching copper and operating-mode wiring.";
    };
    unresolved = ["host must attach output loads and remaining capacitors only through OUTPUT at the owned output capacitor", "host input and remaining output capacitor bank, inductor copper/current qualification, input loop and complete thermal spreading are outside this macro", "host must connect EN and PS_SYNC explicitly; forced PWM is not enforced by this partial pad map", "native refill and host routing/clearance review required", "ripple, stability, EMI, thermal and assembly qualification remain open"];
    anchor = U;
    allowed_rotations = [0 deg, 90 deg, 180 deg, 270 deg];
    required_layers = ["F.Cu", "In1.Cu", "In2.Cu", "B.Cu"];
    internal_clearance = 0.15 mm;
    net FB;
    net GND;
    net VIN;
    net VOUT;
    member U {
        footprint = "github.com/andenore/CopperLib/packages/parts/ti/tps63020/footprints/TI_DSJ0014_TPS63020.kicad_mod";
        at = (0 mm, 0 mm); rotation = 0 deg;
    }
    // Preserve the source-derived SRP4020TA land spacing as the block moves.
    // This reserves placement only; switch copper remains host-routed.
    member L {
        footprint = "github.com/andenore/CopperLib/packages/parts/bourns/srp4020ta/footprints/Bourns_SRP4020TA.kicad_mod";
        at = (0 mm, 5.4 mm); rotation = 180 deg;
    }
    member R_TOP {
        footprint = "github.com/KiCad/kicad-footprints/Resistor_SMD.pretty/R_0402_1005Metric.kicad_mod";
        at = (-3.1 mm, -0.4 mm); rotation = 0 deg;
    }
    member R_BOT {
        footprint = "github.com/KiCad/kicad-footprints/Resistor_SMD.pretty/R_0402_1005Metric.kicad_mod";
        at = (-3.1 mm, -1.6 mm); rotation = 0 deg;
    }
    member C_VINA {
        footprint = "github.com/KiCad/kicad-footprints/Capacitor_SMD.pretty/C_0402_1005Metric.kicad_mod";
        at = (-1.12 mm, -3.52 mm); rotation = 90 deg;
    }
    member C_OUT {
        footprint = "github.com/KiCad/kicad-footprints/Capacitor_SMD.pretty/C_0805_2012Metric.kicad_mod";
        at = (-4.33 mm, 2.27 mm); rotation = 270 deg;
    }
    pad C_OUT."1" = VOUT;
    pad C_OUT."2" = GND;
    pad U."1" = VIN;
    pad U."2" = GND;
    pad U."3" = FB;
    pad U."4" = VOUT;
    pad U."5" = VOUT;
    pad U."15" = GND;
    pad R_TOP."1" = VOUT;
    pad R_TOP."2" = FB;
    pad R_BOT."1" = FB;
    pad R_BOT."2" = GND;
    pad C_VINA."1" = VIN;
    pad C_VINA."2" = GND;
    track feedback_pin {
        net = FB; layer = "F.Cu"; width = 0.18 mm;
        points = [U."3", R_TOP."2"];
    }
    track feedback_divider {
        net = FB; layer = "F.Cu"; width = 0.18 mm;
        points = [R_TOP."2", (-2.59 mm, -1 mm), (-3.61 mm, -1 mm), R_BOT."1"];
    }
    track quiet_return {
        net = GND; layer = "F.Cu"; width = 0.2 mm;
        points = [R_BOT."2", (-2.2 mm, -1.6 mm), (-1.95 mm, -1 mm), U."2", (0 mm, -1 mm), (0 mm, 0 mm)];
    }
    track analog_bypass_feed {
        net = VIN; layer = "F.Cu"; width = 0.2 mm;
        points = [U."1", (-1.12 mm, -1.5 mm), C_VINA."1"];
    }
    track analog_supply_entry {
        net = VIN; layer = "F.Cu"; width = 0.2 mm;
        points = [C_VINA."1", (-0.65 mm, -3.5 mm), (1.3 mm, -3.5 mm)];
    }
    track output_sense_entry {
        net = VOUT; layer = "F.Cu"; width = 0.2 mm;
        points = [R_TOP."1", (-4.5 mm, -0.4 mm), (-4.5 mm, 1.15 mm), C_OUT."1"];
    }
    // Both output contacts must meet locally; a remote same-net connection
    // through the host rail does not provide the intended parallel power path.
    track output_pin_parallel {
        net = VOUT; layer = "F.Cu"; width = 0.3 mm;
        points = [U."4", U."5"];
    }
    track output_capacitor_feed {
        net = VOUT; layer = "F.Cu"; width = 0.3 mm;
        points = [U."4", (-2.72 mm, 1.32 mm), C_OUT."1"];
    }
    track output_load_entry {
        net = VOUT; layer = "F.Cu"; width = 0.3 mm;
        points = [C_OUT."1", (-5.4 mm, 1.32 mm)];
    }
    track output_ground_neck {
        net = GND; layer = "F.Cu"; width = 0.5 mm;
        points = [C_OUT."2", (-4.33 mm, 4.22 mm)];
    }
    via output_capacitor_ground {
        net = GND; at = (-4.33 mm, 4.22 mm); size = 0.6 mm; drill = 0.3 mm;
        from_layer = "F.Cu"; to_layer = "B.Cu"; technology = none;
    }
    track bypass_ground_neck {
        net = GND; layer = "F.Cu"; width = 0.2 mm;
        points = [C_VINA."2", (-1.12 mm, -4.8 mm)];
    }
    track exposed_pad_ground_neck {
        net = GND; layer = "F.Cu"; width = 0.35 mm;
        points = [(0 mm, 0 mm), (0 mm, -2.75 mm)];
    }
    track exposed_pad_second_neck {
        net = GND; layer = "F.Cu"; width = 0.35 mm;
        points = [(0 mm, 0 mm), (0.7 mm, -2.75 mm)];
    }
    via analog_bypass_ground {
        net = GND; at = (-1.12 mm, -4.8 mm); size = 0.6 mm; drill = 0.3 mm;
        from_layer = "F.Cu"; to_layer = "B.Cu"; technology = none;
    }
    via exposed_pad_ground {
        net = GND; at = (0 mm, -2.75 mm); size = 0.6 mm; drill = 0.3 mm;
        from_layer = "F.Cu"; to_layer = "B.Cu"; technology = none;
    }
    via exposed_pad_ground_second {
        net = GND; at = (0.7 mm, -2.75 mm); size = 0.6 mm; drill = 0.3 mm;
        from_layer = "F.Cu"; to_layer = "B.Cu"; technology = none;
    }
    port ANALOG_INPUT {
        net = VIN; layer = "F.Cu"; point = (1.3 mm, -3.5 mm);
        pads = [U."1", C_VINA."1"];
    }
    port OUTPUT {
        net = VOUT; layer = "F.Cu"; point = (-5.4 mm, 1.32 mm);
        pads = [U."4", U."5", C_OUT."1", R_TOP."1"];
    }
    plane_return ground_plane {
        net = GND; layers = ["In1.Cu", "In2.Cu"];
        pads = [U."2", U."15", R_BOT."2", C_VINA."2", C_OUT."2"];
        contact output_contact { pad = C_OUT."2"; at = (-4.33 mm, 4.22 mm); }
        contact bypass_contact { pad = C_VINA."2"; at = (-1.12 mm, -4.8 mm); }
        contact exposed_pad_contact { pad = U."15"; at = (0 mm, -2.75 mm); }
    }
    protected_region quiet_control {
        layers = ["F.Cu"];
        vertices = [(-4.1 mm, -4.4 mm), (-0.95 mm, -4.4 mm), (-0.95 mm, -0.26 mm), (-4.1 mm, -0.26 mm)];
        block_tracks = true; block_vias = true; block_zones = true;
    }
    protected_region output_and_sense {
        layers = ["F.Cu"];
        vertices = [(-1.15 mm, -0.65 mm), (-1.15 mm, 0.7 mm), (-1.8 mm, 0.7 mm), (-2.8 mm, 1.7 mm), (-4.9 mm, 1.7 mm), (-4.9 mm, -0.65 mm)];
        block_tracks = true; block_vias = true; block_zones = true;
    }
    width_contract analog_pin_feed {
        track = analog_bypass_feed; minimum_width = 0.2 mm; purpose = "control_supply";
        evidence = "VINA bypass branch only; main VIN current is routed separately by host. TI SLVS916I section 10.1 intent; authored adaptation.";
    }
    width_contract analog_entry {
        track = analog_supply_entry; minimum_width = 0.2 mm; purpose = "control_supply";
        evidence = "VINA bypass branch only; not main converter supply current.";
    }
    width_contract kelvin_sense {
        track = output_sense_entry; minimum_width = 0.2 mm; purpose = "output_sense";
        evidence = "Separate high-impedance branch terminates at owned C_OUT positive, protected against upstream host-load attachments.";
    }
    width_contract parallel_output_contacts {
        track = output_pin_parallel; minimum_width = 0.3 mm; purpose = "pin_entry";
        evidence = "Authored 0.5 mm local join of adjacent VOUT4/VOUT5 lands. Owned output capacitor feed is distinct from sense branch; current and thermal qualification remain open.";
    }
}

